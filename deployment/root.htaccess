# Proposed root dispatcher. Install only after verified backups and live approval.
Options -Indexes -MultiViews
<IfModule mod_rewrite.c>
RewriteEngine On
# Inherited rules must leave all subdomain hosts to their own applications.
RewriteCond %{HTTP_HOST} !^(?:www\.)?digitaltalha\.com$ [NC]
RewriteRule ^ - [L]
# Keep the internal release path out of public URLs.
RewriteCond %{THE_REQUEST} \s/+\.digitaltalha-release-20261108(?:/|[?\s]) [NC]
RewriteRule ^ - [F,L]
RewriteRule ^\.digitaltalha-release-20261108(?:/|$) - [L]
# Canonical origin before dispatch; existing child applications keep their paths.
RewriteCond %{HTTP_HOST} ^www\.digitaltalha\.com$ [NC]
RewriteRule ^ https://digitaltalha.com%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ https://digitaltalha.com%{REQUEST_URI} [R=301,L]
# Preserve public WordPress shortlinks while retaining other query parameters.
RewriteCond %{QUERY_STRING} ^(.*&)?(?:p|page_id)=454(?:&(.*))?$
RewriteRule ^$ /about/?%1%2 [R=301,L,NE,QSD]
RewriteCond %{QUERY_STRING} ^(.*&)?(?:p|page_id)=456(?:&(.*))?$
RewriteRule ^$ /contact/?%1%2 [R=301,L,NE,QSD]
RewriteCond %{QUERY_STRING} ^(.*&)?(?:p|page_id)=458(?:&(.*))?$
RewriteRule ^$ /terms-conditions/?%1%2 [R=301,L,NE,QSD]
RewriteCond %{QUERY_STRING} ^(.*&)?(?:p|page_id)=460(?:&(.*))?$
RewriteRule ^$ /privacy-policy/?%1%2 [R=301,L,NE,QSD]
RewriteCond %{QUERY_STRING} ^(.*&)?(?:p|page_id)=484(?:&(.*))?$
RewriteRule ^$ /services/?%1%2 [R=301,L,NE,QSD]
RewriteCond %{QUERY_STRING} ^(.*&)?(?:p|page_id)=504(?:&(.*))?$
RewriteRule ^$ /blog/?%1%2 [R=301,L,NE,QSD]
RewriteCond %{QUERY_STRING} ^(.*&)?(?:p|page_id)=605(?:&(.*))?$
RewriteRule ^$ /google-ads/?%1%2 [R=301,L,NE,QSD]
RewriteCond %{QUERY_STRING} ^(.*&)?(?:p|page_id)=607(?:&(.*))?$
RewriteRule ^$ /meta-ads/?%1%2 [R=301,L,NE,QSD]
RewriteCond %{QUERY_STRING} ^(.*&)?(?:p|page_id)=782(?:&(.*))?$
RewriteRule ^$ /how-to-build-a-meta-lead-generation-campaign-from-setup-to-optimization/?%1%2 [R=301,L,NE,QSD]
# Preserve every existing application directory, including older practice sites.
RewriteRule ^(?:demo|gtmpractice|shop|marketing|ecommerce|practice|\.well-known)(?:/|$) - [L]
RewriteRule ^llms\.txt$ - [L]
# Existing media URLs stay available; never execute PHP in the upload directory.
RewriteRule ^wp-content/uploads/.*\.(?:php[0-9]?|phtml|phar)(?:/|$) - [F,L,NC]
RewriteRule ^wp-content/uploads(?:/|$) - [L]
# All main-site routes are served from the complete, preuploaded release.
RewriteRule ^(.*)$ /.digitaltalha-release-20261108/$1 [L]
</IfModule>
